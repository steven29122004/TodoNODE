<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-500">
    <div class="mx-auto px-26 mt-15">
        <div class="input">
            <input
                class="bg-gray-50 border border-gray-300 p-5 text-gray-900 text-sm rounded-l focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5  dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500 "
                type=" text" placeholder="input here">
        </div>
        <% product.forEach(item=> {%>
            <div class="flex justify-between bg-gray-50 border border-b-blue-900 p-4">
                <div>
                    <h1 class="py-3 text-bold italic text-lg font-medium text-gray-900">
                        <%= item.name %>
                    </h1>
                </div>
                <div class="">
                    <button
                        class="text-white bg-gradient-to-br from-green-400 to-blue-600 hover:bg-gradient-to-bl focus:ring-4 focus:outline-none focus:ring-green-200 dark:focus:ring-green-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2">Edit</button>
                    <button
                        class="text-white bg-gradient-to-br from-pink-500 to-orange-400 hover:bg-gradient-to-bl focus:ring-4 focus:outline-none focus:ring-pink-200 dark:focus:ring-pink-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2">Delete</button>
                </div>
            </div>
            <% })%>
    </div>
</body>

</html>