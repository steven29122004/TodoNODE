<script>
    let Input = document.getElementById('inputID');
    const newInput = document.getElementById('newInput');










    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const parent = btn.closest('.todo-item');
            const content = parent.querySelector('.todo-name');
            const inputNew = parent.querySelector('.edit-input');
            const editButton = parent.querySelector('.edit-btn');
            const SaveButton = parent.querySelector('.save-btn');
            const clickable = parent.querySelector('#clickable')

            content.classList.add('hidden');
            inputNew.classList.remove('hidden');
            editButton.classList.add('hidden');
            SaveButton.classList.remove('hidden');

            clickable.classList.add('pointer-events-none');

        })

    })


    document.querySelectorAll('.save-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.preventDefault();
            const parent = btn.closest('.todo-item');
            const content = parent.querySelector('.todo-name');
            const inputNew = parent.querySelector('.edit-input');
            const editButton = parent.querySelector('.edit-btn');
            const SaveButton = parent.querySelector('.save-btn');
            const clickable = parent.querySelector('#clickable');

            const id = parent.getAttribute('data-id');
            fetch(`http://localhost:3000/edit/${id}`, {
                method: 'PUT',
                headers: {
                    'Content-type': 'application/json; charset = UTF-8'
                },
                body: JSON.stringify({
                    name: inputNew.value
                })
            })
                .then((res) => res.json())
                .then((json) => {
                    content.textContent = inputNew.value;
                    content.classList.remove('hidden');
                    inputNew.classList.add('hidden');
                    editButton.classList.remove('hidden');
                    SaveButton.classList.add('hidden');

                    clickable.classList.remove('pointer-events-none');
                })

        })
    })



    document.getElementById('submit').addEventListener('click', () => {

        const body = JSON.stringify({
            name: Input.value
        });
        fetch('http://localhost:3000/', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json; charset=UTF-8'
            },
            body,
        }).then((res) => res.json())
            .then((json) => {
                if (json == 200) {
                    window.location.href = '/'
                } else {
                    alert('please input')
                }
            });
    })




    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            fetch(`http://localhost:3000/${id}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json; charset=UTF-8'
                },
            }).then((res) => res.json())
                .then((json) => {
                    if (json == 200) {
                        window.location.href = '/'
                    } else {
                        message("Server Internal Error");
                    }
                })
        })
    })

