<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-500">
    <div class="mx-auto px-26 mt-15 ">
        <div class="relative">
            <input type="text"
                class="w-full bg-gray-700 text-white placeholder:text-slate-400 text-slate-700 text-sm border rounded-md pl-3 pr-16 py-5 transition duration-300 ease shadow-sm focus:shadow"
                placeholder="Input here" />
            <button
                class="absolute right-3 top-4 rounded bg-slate-800 py-1 px-2.5 border border-transparent text-center text-sm text-white transition-all shadow-sm hover:shadow focus:bg-slate-700 focus:shadow-none active:bg-slate-700 hover:bg-slate-700 active:shadow-none disabled:pointer-events-none disabled:opacity-50 disabled:shadow-none"
                type="button">
                Invite
            </button>
        </div>
        <% product.forEach(item=> {%>
            <div class="flex justify-between bg-gray-50 border border-b-blue-900 p-4">
                <div>
                    <h1 class="py-3 text-bold italic text-lg font-medium text-gray-900">
                        <%= item.name %>
                    </h1>
                </div>
                <div class="">
                    <button
                        class="bg-white hover:bg-gray-100 text-gray-800 font-semibold py-2 px-4 border border-gray-400 rounded shadow">Edit</button>
                    <button
                        class="bg-red-500 text-white hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 rounded inline-flex items-center">Delete</button>
                </div>
            </div>
            <% })%>
    </div>
</body>

</html>