<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-500">


    <div class="mx-auto px-26 mt-15 ">
        <div class="relative">
            <input type="text" id="inputID"
                class="w-full bg-gray-700 text-white placeholder:text-slate-400 text-slate-700 text-sm border rounded-md pl-3 pr-16 py-5 transition duration-300 ease shadow-sm focus:shadow"
                placeholder="Input here" />
            <button
                class="absolute right-3 top-4 rounded p-5 bg-slate-800 py-1 px-2.5 text-center text-sm text-white transition-all shadow-sm hover:shadow cursor-pointer hover:bg-slate-400 active:shadow-none disabled:pointer-events-none disabled:opacity-50 disabled:shadow-none"
                type="button" id="submit">
                Add
            </button>
        </div>
        <% TodoList.forEach(item=> {%>
            <div data-id="<%= item.id%>" class="todo-item flex justify-between bg-gray-50 border border-b-blue-900 p-4">
                <div>
                    <span id="clickable"
                        class="todo-name cursor-pointer py-2 text-bold text-lg font-medium text-gray-900"
                        onclick="window.location.href='/<%= item.id%>'">
                        <%= item.name %>
                    </span>
                    <input type="text" id="newInput" value="<%= item.name%>"
                        class="edit-input hidden bg-gray-100 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500">
                </div>
                <div class="">
                    <button
                        class="edit-btn cursor-pointer bg-white hover:bg-gray-100 text-gray-800 font-semibold py-2 px-4 border border-gray-400 rounded shadow">Edit</button>
                    <button
                        class="save-btn hidden cursor-pointer bg-white hover:bg-gray-100 text-gray-800 font-semibold py-2 px-4 border border-gray-400 rounded shadow">
                        Save
                    </button>
                    <button
                        class="delete-btn bg-red-500 text-white hover:bg-gray-400 text-gray-800 font-bold py-2 px-4 cursor-pointer rounded inline-flex items-center"
                        data-id="<%= item.id%>">Delete</button>
                </div>
            </div>
            <% })%>
    </div>

    <!-- <br> -->
